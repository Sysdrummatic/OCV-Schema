{
  "name": "ocvschema",
  "version": "1.0.0",
  "description": "An open, versioned CV schema with offline validation, migrations and CLI tools.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sysdrummatic/OCV-Schema.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema.json": "./dist/schemas/1.0.0/schema.json"
  },
  "bin": {
    "ocv": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "docs",
    "tests/fixtures/conformance.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:package": "tsc",
    "build:site": "vite build && node scripts/copy-site-assets.mjs",
    "build": "npm run build:package && npm run build:site",
    "verify": "npm run check:types && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "vite --host 127.0.0.1",
    "prepack": "npm run build:package"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
